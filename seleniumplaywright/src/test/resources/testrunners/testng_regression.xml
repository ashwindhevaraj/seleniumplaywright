<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Selenium playwright validations" parallel="tests" thread-count="3" verbose="4">
<listeners>
  <listener class-name="com.qa.listener.Extendreportlistener"/>
</listeners>

<test name="Playwright in chromebrowser">
<parameter name="browser" value="chrome"/>
<classes>
<class name="com.qa.Testcases.HomepageTest"/>
</classes>
</test>
<test name="Dashboard page validations">
<parameter name="browser" value="chrome"></parameter>
<classes>
<class name="com.qa.Testcases.Dashboardtest"/>
</classes>
</test>
<test name="Playwright in firefox browser">
<parameter name="browser" value="firefox"/>
<classes>
<class name="com.qa.Testcases.HomepageTest"/>
</classes>
</test>
<test name="Playwright in chromiumbrowser">
<parameter name="browser" value="chromium"/>
<classes>
<class name="com.qa.Testcases.HomepageTest"/>
</classes>
</test>
</suite>
