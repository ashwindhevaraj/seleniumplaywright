<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Selenium playwright validations" parallel="tests" thread-count="3" verbose="4">
<listeners>
  <listener class-name="com.qa.listener.Extendreportlistener"/>
</listeners>
<test name="Playwright in chromebrowser">
<classes>
<class name="com.qa.Testcases.HomepageTest"/>
</classes>
</test>
<test name="Dashboard page validations">
<classes>
<class name="com.qa.Testcases.Dashboardtest"/>
</classes>
</test>
</suite>
